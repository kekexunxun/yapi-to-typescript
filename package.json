{
  "name": "yapi-apifox-to-typescript",
  "version": "4.2.3",
  "description": "根据 YApi 或 Apifox 的接口定义生成 TypeScript/JavaScript 的接口类型及其请求函数代码。",
  "keywords": [
    "yapi",
    "apifox",
    "codegen",
    "typescript"
  ],
  "homepage": "https://github.com/kekexunxun/yapi-to-typescript",
  "bugs": {
    "url": "https://github.com/kekexunxun/yapi-to-typescript/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:kekexunxun/yapi-to-typescript.git"
  },
  "license": "MIT",
  "author": {
    "name": "binwei",
    "email": "462387164@qq.com",
    "url": "https://github.com/kekexunxun"
  },
  "sideEffects": false,
  "main": "lib/cjs/index.js",
  "module": "lib/esm/index.js",
  "types": "lib/esm/index.d.ts",
  "bin": {
    "ytt": "lib/cjs/cli.js"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "vite build --mode esm && vite build --mode cjs",
    "release": "commit-and-tag-version -a && npm run build && git push --follow-tags origin master && npm publish",
    "releaseBeta": "commit-and-tag-version -a --release-as patch --prerelease beta && npm run build && git push --follow-tags origin master && npm publish --tag next",
    "testApi": "ts-node src/cli.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{css,less,scss,sass,html,htm,vue,yml,yaml,json,md}": "prettier --write",
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@types/json-schema": "^7.0.15",
    "axios": "^1.20.0",
    "change-case": "^5.4.4",
    "consola": "^3.4.2",
    "dayjs": "^1.11.23",
    "form-data": "^4.0.6",
    "fs-extra": "^11.4.1",
    "get-port": "^7.2.0",
    "json-schema-to-typescript": "^16.0.0",
    "json5": "^2.2.3",
    "node-fetch": "^3.3.2",
    "ora": "^9.4.1",
    "prettier": "^3.9.9",
    "prompts": "^2.4.2",
    "signal-exit": "^4.1.0",
    "swagger-client": "^3.38.2",
    "to-json-schema": "^0.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.20.5",
    "@types/node-fetch": "^2.6.13",
    "@types/prompts": "^2.4.9",
    "@types/swagger-schema-official": "^2.0.25",
    "@types/to-json-schema": "^0.2.4",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "commit-and-tag-version": "^13.2.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "openapi-types": "^12.1.3",
    "vite": "^8.3.3",
    "vite-plugin-dts": "^5.1.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
