{
  "compilerOptions": {
    "strict": true,
    "target": "ES5",
    "module": "CommonJS",
    "moduleResolution": "node",
    "declaration": true,
    "removeComments": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "newLine": "LF",
    "preserveSymlinks": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "lib": ["ESNext", "DOM"],
    "paths": {
      "yapi-apifox-to-typescript": ["./src/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "lib", "vite.config.mts"]
}
